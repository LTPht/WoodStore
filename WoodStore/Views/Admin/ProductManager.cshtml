@using WoodStore.Models.ViewModel
@model IEnumerable<WoodStore.Models.Product>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Product Management";
}

<h2>Product Management</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Wood Type</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Purchase Count</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.WoodType</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Stock</td>
                <td>@product.PurchaseCount</td>
                <td>
                    <a asp-controller="AdminProduct" asp-action="Edit" asp-route-id="@product.Id">Edit</a> |
                    <a asp-controller="AdminProduct" asp-action="Delete" asp-route-id="@product.Id"
                       onclick="return confirm('Are you sure you want to delete this product?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
